#!/usr/bin/make -f
# Build a DKMS-only source package: install the source tree under
# /usr/src/<pkg>-<ver>/ and let our postinst/prerm invoke dkms.

export DH_VERBOSE = 1

PKG       = armcb-isp-v4l2-dkms
DKMS_NAME = armcb-isp-v4l2
DKMS_VER  = 1.0.0
DEST      = debian/$(PKG)/usr/src/$(DKMS_NAME)-$(DKMS_VER)

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:
	mkdir -p $(DEST)
	rsync -a \
	  --exclude='*.o' --exclude='*.ko' --exclude='*.mod' --exclude='*.mod.c' \
	  --exclude='.*.cmd' --exclude='*.cmd' --exclude='*.bak' \
	  --exclude='*.o.d' --exclude='*.a' \
	  --exclude='Module.symvers' --exclude='modules.order' \
	  --exclude='*.patch' --exclude='*.md' --exclude='docs' \
	  --exclude='.git*' --exclude='debian' --exclude='packaging' \
	  --exclude='/1' --exclude='/q' --exclude='sensor/1' \
	  ./ $(DEST)/

override_dh_auto_clean:
